# Target Backend: 'GAS' (Google Apps Script) or 'SUPABASE'
VITE_BACKEND_TARGET=GAS

# Set to true to use mock data instead of live backend
VITE_USE_MOCK=false

# Supabase Configuration (Replace with your actual keys from Supabase Dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Apps Script Configuration
VITE_API_BASE_URL=https://script.google.com/macros/s/your-gas-exec-id/exec
